# Minecraft server (Aternos, ViaVersion/ViaBackwards compatible)
MC_HOST=EmpiSMP.aternos.me
MC_PORT=32990
MC_VERSION=auto
# debug prints every movement/lifecycle trace; use info for normal runs.
LOG_LEVEL=info
# Set true only when diagnosing protocol traffic; even at LOG_LEVEL=debug,
# per-packet TRACE lines stay off unless this is true.
MC_TRACE_PACKETS=false
# Validated status ping used before any login socket; sleeps while Aternos starts.
# Resolved versions are restricted to minecraft-protocol's supported versions.
MC_VERSION_PROBE_TIMEOUT_MS=8000
MC_SERVER_START_DELAY_MS=30000
MC_VERSION_RETRY_MS=60000
MC_AUTH=offline
# Positive, jittered spacing between joins. Ten simultaneous logins are what
# produced the throttle/AUTH_TIMEOUT storm in the live 20:26 run. If Paper or
# Aternos applies a per-IP throttle, the runtime still records one strike per
# outage and opens a bounded fleet-wide pause.
MC_JOIN_INTERVAL_MS=2000
MC_JOIN_JITTER_MS=750
MC_CONNECT_STAGGER_MS=1500
MC_CONNECT_JITTER_MS=750
FLEET_CONCURRENCY=4
# Throttled joins wait longer than ordinary reconnect failures.
MC_THROTTLE_DELAY_MS=90000
MC_THROTTLE_MAX_DELAY_MS=600000
MC_RECONNECT_JITTER_MS=4000

# Connection stages are budgeted separately so a resolver/TCP hang is not
# reported as a protocol-login timeout.
MC_DNS_TIMEOUT_MS=10000
# Client-requested chunk radius (an integer 2-32, or tiny=6, short=8, normal=10,
# far=12). Default 2: ten bots at 6 held 1,690 chunk columns and froze the event
# loop for 26s. Raise only after the event-loop delay on the dashboard is healthy.
MC_VIEW_DISTANCE=2
# Hard cap for the effective radius. An old MC_VIEW_DISTANCE=tiny is capped
# here and the startup log says so. Raise only when the host has headroom.
MC_VIEW_DISTANCE_MAX=2
MC_INBOUND_YIELD=true
MC_CONNECT_TIMEOUT_MS=45000
MC_LOGIN_TIMEOUT_MS=30000
MC_CONFIGURATION_TIMEOUT_MS=15000
MC_SPAWN_TIMEOUT_MS=45000

# Client-side watchdog threshold. minecraft-protocol replies to keep_alive
# itself; this only controls when the library declares the socket dead.
MC_KEEPALIVE_MS=60000
# A connected socket that has sent no packet for this long is shown as
# "No packets" instead of online (guards silent NAT/proxy drops).
MC_STALE_AFTER_MS=45000
# Hold a rejoin briefly; the per-bot backoff and fleet throttle still apply.
MC_REJOIN_DELAY_MS=5000

# Plugin authentication is OPT-IN and challenge-driven. The default `none`
# never sends /login or /register. Supported profiles:
#   none, offline, microsoft, manual, authme, simpleauth, generic
# A plugin profile waits for the server's own prompt before sending anything.
# Registration is off unless explicitly enabled below.
MC_AUTH_PROFILE=none
MC_AUTH_ENABLED=false
MC_AUTH_REGISTRATION_ENABLED=false
MC_AUTH_MAX_ATTEMPTS=2
MC_AUTH_RETRY_DELAY_MS=1500
# Per-bot credentials live in an ignored JSON file, never in Git:
#   {"________": {"password": "..."}, "10101000": {"password": "..."}}
MC_CREDENTIALS_FILE=.mc-auth.json
# Legacy single-fleet credentials are read only when a profile is active.
MC_REGISTER_PASSWORD=
MC_LOGIN_PASSWORD=
MC_LOGIN_COMMAND=/login {password}
MC_REGISTER_COMMAND=/register {password} {password}
# Optional per-server overrides; blank uses the selected profile's default
# (AuthMe registration asks twice, SimpleAuth commonly asks once).
MC_AUTH_LOGIN_TEMPLATE=
MC_AUTH_REGISTER_TEMPLATE=
MC_AUTH_DELAY_MS=300
MC_AUTH_TIMEOUT_MS=12000
# Cosmetic join command. It is sent once per ready session, after spawn and any
# password authentication, so an auth plugin can never treat /skin as a login
# attempt. Set MC_SKIN_ON_JOIN=false for a server without a skin plugin.
MC_SKIN_ON_JOIN=true
MC_SKIN_COMMAND=/skin uH3WR2v0ti0uTHJ
MC_SKIN_DELAY_MS=1500

# Dashboard: loopback is the default. Binding the control plane beyond loopback without
# DASHBOARD_TOKEN is refused unless DASHBOARD_ALLOW_INSECURE=true explicitly
# opts in for a trusted local preview (the sandbox uses this).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_LOCAL=0
DASHBOARD_TOKEN=
DASHBOARD_ALLOW_INSECURE=0

# Deterministic local simulation (no Minecraft server required)
MC_SIMULATE=0
SIM_SEED=chickenbots-v4

# PvE is safe automation and on by default. PvP is enabled as a feature, but
# PvpPolicy only attacks players on the explicit target list. SERVER_PVP_ENABLED
# must be false when the Minecraft server itself sets pvp=false.
PVE_ENABLED=true
PvP_ENABLED=true
SERVER_PVP_ENABLED=true

AUTONOMY_ENABLED=true
# Off by default: a new runtime starts with an empty task board and idle bots.
# Turn the survival planner on at runtime with `team plan on`, or set this true
# to plan from the first tick.
AUTONOMY_AUTO_PLAN=false
TEAM_TICK_MS=1000
AUTONOMY_TICK_MS=750

# Shared woodcutting/mining area centred on home. A 100x100 zone keeps the
# fleet from chasing trees or veins out of the base area and getting lost.
WORK_ZONE_ENABLED=true
WORK_ZONE_SIZE=100
WORK_ZONE_MARGIN=2

# Autonomy pacing. The fleet waits for the spawn chunk burst to settle before
# starting pathfinders, and only this many bots may be inside a long action.
AUTONOMY_WARMUP_MS=20000
AUTONOMY_CONCURRENCY=4
# A hung autonomous step is cancelled after this budget so it cannot own a slot.
ACTION_TIMEOUT_MS=60000
# Safety (eat/flee/defend) has a shorter hard budget than task work: the next
# scheduler turn must not wait behind a 60s retreat.
EMERGENCY_BUDGET_MS=6000
# While a task is running, check for damage/lava/fire/low health this often and
# cancel the task so the next safety pass can respond.
SAFETY_PREEMPT_MS=500
# Cooperative A* budgets: yield often, cap the total search. These are the
# autonomous-task budgets; an operator goto/come/follow gets the larger pair
# below so a long walk is not abandoned mid-plan.
PATHFINDER_THINK_TIMEOUT_MS=2500
PATHFINDER_TICK_TIMEOUT_MS=10
PATHFINDER_OPERATOR_THINK_TIMEOUT_MS=8000
PATHFINDER_OPERATOR_TICK_TIMEOUT_MS=25
PATHFINDER_SEARCH_RADIUS=64
# Scale the detour budget with distance; clamp between the floor above and this
# ceiling. Ad-hoc PATHFINDER_SEARCH_RADIUS values remain the floor.
NAV_ADAPTIVE_SEARCH_RADIUS=true
NAV_SEARCH_RADIUS_SCALE=1.5
NAV_SEARCH_RADIUS_MAX=512
# One recovery retry for a task, three attempts for an operator move.
NAV_TASK_ATTEMPTS=2
NAV_OPERATOR_ATTEMPTS=3
NAV_STUCK_WINDOW_MS=2500
NAV_RECOVERY_DELAY_MS=250
# Route profile: safe|fast|balanced|cautious|follow|combat|retreat|task.
NAV_ROUTE_MODE=balanced
# Dimension safety envelope: overworld|nether|end. Caps fall distance in the
# Nether/End and rejects targets outside the world height.
NAV_DIMENSION=overworld
# Deterministic planner ceiling per move. 700 ms keeps a 5-bot build inside the
# shared planning window under test load; 350-500 ms starved it.
NAV_PLAN_BUDGET_MS=700
# Routine travel never digs, scaffolds or opens doors.
NAV_ALLOW_DIG=false
NAV_ALLOW_SCAFFOLD=false
NAV_OPEN_DOORS=false
# Drop movement and re-anchor to the server after a freeze/suspend.
CLIENT_STALL_GUARD_MS=2500
CLIENT_STALL_RESUME_MS=1500
