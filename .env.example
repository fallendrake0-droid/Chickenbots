# Minecraft server (Aternos, ViaVersion/ViaBackwards compatible)
MC_HOST=cr3xlol.aternos.me
MC_PORT=55742
MC_VERSION=auto
MC_AUTH=offline

# Optional AuthMe-style registration/login (leave blank if the server has none)
MC_REGISTER_PASSWORD=
MC_LOGIN_PASSWORD=

# Dashboard: bind 0.0.0.0 so the sandbox preview works; use 127.0.0.1 locally.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# Deterministic local simulation (no Minecraft server required)
MC_SIMULATE=0
SIM_SEED=chickenbots-v4

AUTONOMY_ENABLED=true
TEAM_TICK_MS=1000
AUTONOMY_TICK_MS=750
LOG_LEVEL=info
