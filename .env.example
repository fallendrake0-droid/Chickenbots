# Minecraft server (Aternos, ViaVersion/ViaBackwards compatible)
MC_HOST=EmpiSMP.aternos.me
MC_PORT=32990
MC_VERSION=auto
# debug prints every movement/lifecycle trace; use info for normal runs.
LOG_LEVEL=info
# Set true only when diagnosing protocol traffic; even at LOG_LEVEL=debug,
# per-packet TRACE lines stay off unless this is true.
MC_TRACE_PACKETS=false
# Validated status ping used before any login socket; sleeps while Aternos starts.
# Resolved versions are restricted to minecraft-protocol's supported versions.
MC_VERSION_PROBE_TIMEOUT_MS=8000
MC_SERVER_START_DELAY_MS=30000
MC_VERSION_RETRY_MS=60000
MC_AUTH=offline
# Paper/Aternos applies a per-IP connection throttle. Every bot here shares one
# source IP, so joins are exactly 10s apart by default. All failures in one
# outage record a single strike (90s); a separate outage after a bot is ready
# escalates the bounded cooldown (180s -> ... -> 10m).
MC_JOIN_INTERVAL_MS=10000
MC_JOIN_JITTER_MS=0
MC_CONNECT_STAGGER_MS=10000
MC_CONNECT_JITTER_MS=0
# Throttled joins wait longer than ordinary reconnect failures.
MC_THROTTLE_DELAY_MS=90000
MC_THROTTLE_MAX_DELAY_MS=600000
MC_RECONNECT_JITTER_MS=4000

# Connection stages are budgeted separately so a resolver/TCP hang is not
# reported as a protocol-login timeout.
MC_DNS_TIMEOUT_MS=10000
# Client-requested chunk radius (tiny=6, short=8, normal=10, far=12) or 2-32.
# Default short: ten simultaneous 'far' joins decompress hundreds of chunks
# each on the protocol thread and can starve the 20 tps client tick loop.
MC_VIEW_DISTANCE=tiny
MC_INBOUND_YIELD=true
MC_CONNECT_TIMEOUT_MS=45000
MC_LOGIN_TIMEOUT_MS=30000
MC_CONFIGURATION_TIMEOUT_MS=15000
MC_SPAWN_TIMEOUT_MS=45000

# Client-side watchdog threshold. minecraft-protocol replies to keep_alive
# itself; this only controls when the library declares the socket dead.
MC_KEEPALIVE_MS=120000
# A connected socket that has sent no packet for this long is shown as
# "No packets" instead of online (guards silent NAT/proxy drops).
MC_STALE_AFTER_MS=90000
# Wait this long after a real session ends before the first rejoin. Initial
# joins are not delayed; this only avoids Aternos' post-disconnect throttle.
MC_REJOIN_DELAY_MS=10000

# AuthMe-style login. There is no built-in password: fill these in your local
# .env and never commit it. A live connecting run refuses to start with auth
# enabled and both values empty. Accounts already exist, so bots send only
# /login. Set MC_AUTH_REGISTER_ON_FIRST_JOIN=true only when creating a
# brand-new account. Set MC_AUTH_ENABLED=false if the server has no password
# plugin. Each bot stays frozen and unready until the server confirms the
# password in chat.
MC_AUTH_ENABLED=true
MC_AUTH_REGISTER_ON_FIRST_JOIN=false
MC_REGISTER_PASSWORD=
MC_LOGIN_PASSWORD=
MC_LOGIN_COMMAND=/login {password}
MC_REGISTER_COMMAND=/register {password} {password}
MC_AUTH_DELAY_MS=300
MC_AUTH_TIMEOUT_MS=12000

# Dashboard: loopback is the default. Binding the control plane beyond loopback without
# DASHBOARD_TOKEN is refused unless DASHBOARD_ALLOW_INSECURE=true explicitly
# opts in for a trusted local preview (the sandbox uses this).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_LOCAL=0
DASHBOARD_TOKEN=
DASHBOARD_ALLOW_INSECURE=0

# Deterministic local simulation (no Minecraft server required)
MC_SIMULATE=0
SIM_SEED=chickenbots-v4

# PvE is safe automation and on by default. PvP is enabled as a feature, but
# PvpPolicy only attacks players on the explicit target list. SERVER_PVP_ENABLED
# must be false when the Minecraft server itself sets pvp=false.
PVE_ENABLED=true
PvP_ENABLED=true
SERVER_PVP_ENABLED=true

AUTONOMY_ENABLED=true
TEAM_TICK_MS=1000
AUTONOMY_TICK_MS=750
