# Minecraft server (Aternos, ViaVersion/ViaBackwards compatible)
MC_HOST=cr3xlol.aternos.me
MC_PORT=55742
MC_VERSION=auto
MC_AUTH=offline
# Aternos throttles rapid joins; open one socket every ~7s with jitter.
MC_CONNECT_STAGGER_MS=7000
MC_CONNECT_JITTER_MS=2000
# Throttled joins wait longer than ordinary reconnect failures.
MC_THROTTLE_DELAY_MS=30000
MC_RECONNECT_JITTER_MS=4000

# Optional AuthMe-style registration/login (leave blank if the server has none).
# When set, each bot stays frozen and unready until the server confirms the
# password in chat; it will not move or start autonomy before then.
MC_REGISTER_PASSWORD=
MC_LOGIN_PASSWORD=
MC_AUTH_DELAY_MS=1000
MC_AUTH_TIMEOUT_MS=12000

# Dashboard: bind 0.0.0.0 so the sandbox preview works; use 127.0.0.1 locally.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# Deterministic local simulation (no Minecraft server required)
MC_SIMULATE=0
SIM_SEED=chickenbots-v4

# PvP is off by default. SERVER_PVP_ENABLED must be false when the Minecraft
# server itself sets pvp=false; the controller then refuses every player attack.
PvP_ENABLED=false
SERVER_PVP_ENABLED=true

AUTONOMY_ENABLED=true
TEAM_TICK_MS=1000
AUTONOMY_TICK_MS=750
LOG_LEVEL=info
